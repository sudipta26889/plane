# =============================================================================
# TaskPilot — Single Source of Truth for All Services
# =============================================================================

# ---------- Django ----------
SECRET_KEY=""
DEBUG=0
ALLOWED_HOSTS="taskpilot.example.com,taskpilot-api.example.com"
CORS_ALLOWED_ORIGINS="https://taskpilot.example.com,https://taskpilot-api.example.com"
COOKIE_DOMAIN=".example.com"

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER="taskpilot"
POSTGRES_PASSWORD=""
POSTGRES_HOST="db.example.com"
POSTGRES_DB="taskpilot"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://taskpilot:CHANGE_ME@db.example.com:5432/taskpilot"

# ---------- Redis ----------
REDIS_HOST="redis.example.com"
REDIS_PORT="6379"
REDIS_URL="redis://redis.example.com:6379/0"

# ---------- RabbitMQ (Local Container) ----------
RABBITMQ_HOST="taskpilot-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="taskpilot"
RABBITMQ_PASSWORD=""
RABBITMQ_VHOST="taskpilot"

# ---------- MinIO / S3 ----------
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT_URL="http://minio.example.com:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

# ---------- Public URLs (used by Django backend) ----------
WEB_URL="https://taskpilot.example.com"
APP_BASE_URL="https://taskpilot.example.com"
APP_BASE_PATH=""
ADMIN_BASE_URL="https://taskpilot.example.com"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="https://taskpilot.example.com"
SPACE_BASE_PATH="/spaces"
LIVE_BASE_URL="https://taskpilot.example.com"
LIVE_BASE_PATH="/live"

# ---------- VITE_* (Build-time vars — baked into frontend JS bundles) ----------
VITE_API_BASE_URL="https://taskpilot-api.example.com"
VITE_WEB_BASE_URL="https://taskpilot.example.com"
VITE_ADMIN_BASE_URL="https://taskpilot.example.com"
VITE_ADMIN_BASE_PATH="/god-mode"
VITE_SPACE_BASE_URL="https://taskpilot.example.com"
VITE_SPACE_BASE_PATH="/spaces"
VITE_LIVE_BASE_URL="https://taskpilot.example.com"
VITE_LIVE_BASE_PATH="/live"

# ---------- Live Server (Node.js) ----------
API_BASE_URL="https://taskpilot-api.example.com"
WEB_BASE_URL="https://taskpilot.example.com"

# ---------- Secrets ----------
LIVE_SERVER_SECRET_KEY=""

# ---------- Workers ----------
GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT="60/minute"

# ---------- Deprecated (kept for compatibility) ----------
DOCKERIZED=1  # set but not read by any app — safe to drop
OPENAI_API_BASE="https://api.openai.com/v1"  # set but not read by any app — safe to drop
OPENAI_API_KEY=""  # set but not read by any app — safe to drop
GPT_ENGINE="gpt-3.5-turbo"


LLM_API_BASE_URL="http://litellm.example.com:4000"

# MCP Server
MCP_PORT=4650
MCP_ISSUER_URL="https://taskpilot-mcp.example.com"
VITE_MCP_BASE_URL="https://taskpilot-mcp.example.com"
MCP_RESOURCE_URL="https://taskpilot-mcp.example.com/mcp"  # set but not read by any app — safe to drop
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000
MCP_AUTH_CODE_TTL=600
MCP_DYNAMIC_REGISTRATION=true  # set but not read by any app — safe to drop
FRONTEND_URL="https://taskpilot.example.com"
TASKPILOT_WORKSPACE_SLUG="your-workspace"

# ---------- DharaHIL (Human-in-the-Loop Approval Gateway) ----------
DHARAHIL_BASE_URL="https://dharahil-gateway.example.com"
DHARAHIL_API_KEY=""
DHARAHIL_TENANT_ID=""
DHARAHIL_APP_ID=""
DHARAHIL_ENABLED=true
MCP_HITL_TIMEOUT_MS=300000  # set but not read by any app — safe to drop

ENABLE_DRF_SPECTACULAR=1
DOGRAH_OUR_DIDS="+10000000000"

# ---------- Agent grounding (Qdrant + embeddings) ----------
QDRANT_URL="http://qdrant.example.com:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="taskpilot_vector_db"
# Embedding server. Must be the same model that produced the PKM vectors
# (BAAI/bge-visualized-m3, 1024-dim) or stored vectors become incomparable.
EMBEDDING_DIRECT_URL="http://embeddings.example.com:18081/embed"
# Routing thresholds — see scripts/eval-routing.ts
A2A_ROUTE_CONFIDENCE=0.7
A2A_DEDUPE_SIMILARITY=0.85
# Where low-confidence items are filed, as workspace-slug:PROJECT_IDENTIFIER
# pairs. Leave empty to have the router refuse rather than guess.
A2A_INTAKE_PROJECTS=""
